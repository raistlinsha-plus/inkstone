{
  "name": "inkstone",
  "version": "0.8.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "node scripts/desktop.mjs dev",
    "bundle": "node scripts/desktop.mjs build --bundles app",
    "test": "vitest run && node scripts/check-worker.mjs",
    "docs:check": "node scripts/check-public-docs.mjs",
    "licenses": "node scripts/collect-licenses.mjs",
    "verify": "node scripts/verify.mjs",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "verify:changed": "node scripts/verify.mjs --changed --resume",
    "worklog": "node scripts/worklog.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.0",
    "@fullcalendar/react": "7.1.3",
    "@lezer/highlight": "1.2.5",
    "@milkdown/crepe": "7.22.3",
    "@milkdown/kit": "7.22.3",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "decode-named-character-reference": "^1.3.0",
    "dompurify": "^3.4.17",
    "echarts": "6.1.0",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^0.468.0",
    "markmap-view": "^0.18.12",
    "mermaid": "11.17.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "temporal-polyfill": "1.0.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "8.3.5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "24.14.0",
    "npm": "11.9.0"
  }
}
